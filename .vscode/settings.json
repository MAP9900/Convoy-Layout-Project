{
  // --- Python testing via the Python extension (kept as-is) ---
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.envFile": "${workspaceFolder}/.env",

  // --- Make Code Runner run from the workspace root and use our env --- Does not seem to work currently. Just run tests through testing instead
  "code-runner.runInTerminal": true,
  "code-runner.fileDirectoryAsCwd": false,
  "code-runner.cwd": "${workspaceFolder}",
  "code-runner.env": {
    "PYTHONPATH": "${workspaceFolder}"
  },
  "code-runner.executorMap": {
    "python": "python -u ${file}"
  }
}